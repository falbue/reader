{
    "bot": {
        "name": "Читалка",
        "short_description": "Простая читалка для Telegram",
        "description": "Простое и удобное чтение книг в Telegram\n\nАвтор: @falbue"
    },
    "menu": {
        "none_menu": {
            "text": "Меню `{menu_name}` не найдено",
            "return": "main"
        },
        "main": {
            "text": "📚 Выберите книгу",
            "keyboard": "list_books"
        },
        "read_book|{book_id}|{book_page}": {
            "row": 3,
            "text": "{error|hide}\n\n{book_text}",
            "function": "read_book",
            "keyboard": {
                "read_book|{book_id}|{prev_page}": "{variables.tta_pagination_back}",
                "placeholder": "{book_page}/{total_pages}",
                "read_book|{book_id}|{next_page}": "{variables.tta_pagination_next}"
            },
            "input": {
                "data": "select_page",
                "menu": "read_book|{book_id}",
                "function": "read_book"
            },
            "return": "main"
        }
    },
    "variables": {
        "tta_return": "‹ Назад",
        "tta_loading": "Загрузка...",
        "tta_pagination_back": "‹",
        "tta_pagination_next": "›"
    },
    "commands": {
        "start": {
            "description": "🔄 Перезапуск бота",
            "menu": "main"
        }
    }
}